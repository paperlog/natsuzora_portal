<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>夏空学園 美術室 | ファンアートギャラリー</title>

  <!-- CSSの読み込み -->
  <link rel="stylesheet" href="css/common.css">
  <link rel="stylesheet" href="css/art_room.css">
</head>
<body>

  <!-- 共通ヘッダー -->
  <header class="site-header">
    <div class="header-inner">
      <div class="school-badge">
        <span class="badge-icon">🌻</span>
        <span class="badge-text">PRIVATE NATSUZORA ACADEMY</span>
      </div>
      <h1 class="header-title">夏空学園 美術室</h1>
      <p class="header-subtitle">夏空あさひ ファンアートギャラリー</p>
    </div>

    <nav class="header-nav">
      <a href="index.html">🏫 ポータル</a>
      <a href="student_id_card.html">🏛️ 学務課（学生証）</a>
      <a href="library.html">📚 図書室</a>
      <a href="art_room.html" class="active">🎨 美術室</a>
    </nav>
  </header>

  <main class="page-container">
    <section class="art-notice-card">
      <h2>🎨 美術室の展示について</h2>
      <p class="notice-desc">
        夏空あさひちゃんのファンアート（#夏空学園美術部 等）を展示・保管している非公式ギャラリーです。<br>
        イラストをクリックするとXの元ポストへジャンプし、お気に入りの作品を端末に保存できます。
      </p>

      <div class="notice-badge-box">
        <div class="notice-badge-title">
          <span>⚠️</span> 掲載・更新に関するご案内（人力更新）
        </div>
        <ul class="notice-list">
          <li>当ギャラリーの作品展示は、<strong>管理人による手作業（手動・人力）で巡回・更新</strong>しています。そのため、投稿から反映までにお時間をいただく場合があります。</li>
          <li>掲載されている作品の著作権・権利は各イラストレーター様に帰属します。</li>
          <li>掲載の取り下げ・修正希望、または「掲載してほしい」というリクエストがございましたら、ポータル記載のSNS等からお気軽にご連絡ください。</li>
        </ul>
      </div>
    </section>
    <!-- ステータスバー -->
    <div class="gallery-topbar">
      <div class="status-box">
        <span class="status-dot"></span>
        <span id="galleryCount">作品を読み込み中…</span>
      </div>
      <div class="sort-box">
        <label for="sortSelect">並び順:</label>
        <select id="sortSelect" onchange="changeSort(this.value)">
          <option value="newest" selected>新しい順</option>
          <option value="oldest">古い順</option>
        </select>
      </div>
    </div>

    <!-- ギャラリーグリッド -->
    <div class="gallery-grid" id="galleryGrid">
      <div class="loading-box">art.json を読み込んでいます…</div>
    </div>
  </main>

  <!-- 共通フッター -->
  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-label">📢 夏空あさひ 公式SNS</p>
      <div class="sns-links">
        <a href="https://www.tiktok.com/@asahi.natsuzora" class="sns-btn tiktok" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.33 22a6.33 6.33 0 0 0 6.34-6.32V8.2a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.85-.37v.74z"/></svg>
          <span>TikTok</span>
        </a>
        <a href="https://x.com/asahinatsu_v" class="sns-btn x-twitter" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>X (@asahinatsu_v)</span>
        </a>
      </div>
      <a href="https://x.com/yuu73_39" class="sns-btn x-twitter" target="_blank" rel="noopener" style="margin-bottom: 10px;">開発者sns:不具合等はこちらに</a>
      <p class="copyright">&copy; 夏空学園 非公式ファンポータル</p>
    </div>
  </footer>

  <script>
    let artList = [];
    let sortOrder = 'newest';

    async function initGallery() {
      const grid = document.getElementById('galleryGrid');
      const countEl = document.getElementById('galleryCount');

      try {
        const res = await fetch('./art.json?t=' + Date.now());
        if (!res.ok) throw new Error('art.json の取得に失敗しました');
        artList = await res.json();
      } catch (err) {
        console.error(err);
        countEl.textContent = '読み込み失敗';
        grid.innerHTML = `
          <div class="empty-notice">
            <p>作品データ（art.json）を取得できませんでした。</p>
            <p style="font-size: 0.85rem; color: #888;">ルート直下に art.json が存在するか確認してください。</p>
          </div>`;
        return;
      }

      renderGallery();
    }

    function changeSort(order) {
      sortOrder = order;
      renderGallery();
    }

    function renderGallery() {
      const grid = document.getElementById('galleryGrid');
      const countEl = document.getElementById('galleryCount');

      if (!artList || artList.length === 0) {
        countEl.textContent = '展示数: 0点';
        grid.innerHTML = '<div class="empty-notice">現在展示中の作品はありません。</div>';
        return;
      }

      countEl.innerHTML = `全 <strong>${artList.length}</strong> 点 展示中`;

      const sorted = [...artList].sort((a, b) => {
        const dateA = new Date(a.date || 0).getTime();
        const dateB = new Date(b.date || 0).getTime();
        return sortOrder === 'newest' ? dateB - dateA : dateA - dateB;
      });

      grid.innerHTML = '';

      sorted.forEach(art => {
        const displayTitle = art.title || `${art.author || '夏空あさひ'}のアート`;
        const saveFileName = art.title || `${art.id || 'natsuzora_art'}`;

        const card = document.createElement('article');
        card.className = 'art-card';

        const targetUrl = art.url ? escapeHtml(art.url) : '#';
        const hasUrl = Boolean(art.url);

        card.innerHTML = `
          <a href="${targetUrl}" ${hasUrl ? 'target="_blank" rel="noopener noreferrer"' : ''} class="art-img-link" title="${hasUrl ? 'Xの元ポストを開く' : ''}">
            <div class="art-thumb-container">
              <img src="${art.image}" alt="${escapeHtml(displayTitle)}" loading="lazy" class="art-thumb">
              <div class="thumb-overlay">
                <span class="overlay-badge">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  ポストを開く ↗
                </span>
              </div>
            </div>
          </a>

          <div class="art-meta">
            <h3 class="art-title">${escapeHtml(displayTitle)}</h3>
            
            <div class="art-author-row">
              <span class="art-author">作者: <strong>${escapeHtml(art.author || '匿名生徒')}</strong></span>
              ${hasUrl ? `<a href="${targetUrl}" target="_blank" rel="noopener noreferrer" class="link-x-icon" title="Xで見る">↗</a>` : ''}
            </div>

            ${art.comment ? `<p class="art-comment">${escapeHtml(art.comment)}</p>` : ''}

            <div class="art-footer">
              <span class="art-date">${art.date || ''}</span>
              <button type="button" class="btn-card-save" title="端末に画像をダウンロード">💾 保存</button>
            </div>
          </div>
        `;

        card.querySelector('.btn-card-save').addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const ext = art.image.split('.').pop().split('?')[0] || 'webp';
          downloadImage(art.image, `${saveFileName}.${ext}`);
        });

        grid.appendChild(card);
      });
    }

    async function downloadImage(imageSrc, fileName) {
      try {
        const response = await fetch(imageSrc);
        const blob = await response.blob();
        const blobUrl = URL.createObjectURL(blob);

        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
        const isInApp = /Line|FBAN|FBAV|Twitter/i.test(navigator.userAgent);

        if (isIOS || isInApp) {
          const newTab = window.open(blobUrl, '_blank');
          if (!newTab) window.location.href = blobUrl;
        } else {
          const link = document.createElement('a');
          link.href = blobUrl;
          link.download = fileName;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
        }
      } catch (err) {
        const link = document.createElement('a');
        link.href = imageSrc;
        link.target = '_blank';
        link.download = fileName;
        link.click();
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    window.addEventListener('DOMContentLoaded', initGallery);
  </script>
</body>
</html>
